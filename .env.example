# Public Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin review configuration. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Google Cloud Translation API key (server-only; enable Cloud Translation API in Google Cloud).
GOOGLE_CLOUD_TRANSLATE_API_KEY=
# Comma-separated email addresses allowed to use /admin/translations
ADMIN_EMAILS=
